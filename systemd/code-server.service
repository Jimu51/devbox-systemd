[Unit]
# code-server：在浏览器中运行的 VS Code
Description=VS Code in the browser (code-server)
Documentation=https://github.com/coder/code-server
# 仅要求基础网络栈，不阻塞容器启动
After=network.target

[Service]
Type=simple
# 以 root 运行：devbox 是个人本地开发容器，能登录 = 已是 coder + sudo -i
# 因此直接用 root 简化权限管理（详见 README）
User=root
Group=root
WorkingDirectory=/root
# 环境变量：code-server 与 HOME 相关
Environment=HOME=/root
Environment=XDG_DATA_HOME=/root/.local/share
Environment=XDG_CONFIG_HOME=/root/.config
# 启动命令：监听所有网卡 8443，禁用遥测
ExecStart=/usr/bin/code-server \
    --bind-addr 0.0.0.0:8443 \
    --user-data-dir /root/.local/share/code-server \
    --extensions-dir /root/.local/share/code-server/extensions \
    --config /etc/code-server/config.yaml \
    --disable-telemetry
ExecStop=/bin/kill -TERM $MAINPID
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target